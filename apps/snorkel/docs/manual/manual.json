{
  "title": "Snorkel",
  "title_accent": "Operations Manual",
  "subtitle": "The self-serve guide to procurement at Legend of Toys: requests, purchase orders, vendors, payments, sales orders and the asset register.",
  "version": "1.12.0",
  "date": "2026-09-04",
  "app_url": "snorkel.legendoftoys.com",
  "owner": "Legend of Toys",
  "roles": {
    "req": {
      "label": "Requester",
      "name": "Requester / Anyone at LOT",
      "desc": "Any signed-in team member. Files PO requests for things they need; no special access required."
    },
    "proc": {
      "label": "Procurement",
      "name": "Procurement Team",
      "desc": "Raises and amends purchase orders, accepts requests, manages vendors, forwarders, reorders and new products."
    },
    "appr": {
      "label": "Approver",
      "name": "Approver",
      "desc": "Gives a purchase order its final sign-off after procurement has accepted it."
    },
    "fin": {
      "label": "Finance",
      "name": "Finance / Payments",
      "desc": "Routes approved purchase orders for payment and marks them paid; works the payment queue."
    },
    "adm": {
      "label": "Admin",
      "name": "Manager / Admin",
      "desc": "Full access: everything above plus managing Snorkel roles and assigning them to people."
    }
  },
