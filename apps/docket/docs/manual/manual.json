{
  "title": "Docket",
  "title_accent": "Operations Manual",
  "subtitle": "The self-serve guide to Legend of Toys' org-wide task manager: capturing, owning and tracking work across every department.",
  "version": "2.2.0",
  "date": "2026-11-13",
  "app_url": "docket.legendoftoys.com",
  "owner": "Legend of Toys",
  "roles": {
    "mem": {
      "label": "Member",
      "name": "Member (everyone)",
      "desc": "Any signed-in LOT person. Creates tasks, and sees their own work, anything they collaborate on, and their own department's tasks. Edits the tasks they own or created."
    },
    "view": {
      "label": "Reviewer",
      "name": "Reviewer",
      "desc": "Sees every task across the whole organisation, read-only, plus the review Dashboard. A reviewer watches but does not change other people's tasks."
    },
    "adm": {
      "label": "Admin",
      "name": "Admin",
      "desc": "Full control: sees and edits any task, manages who has which role, and runs the admin screens (roles, users, spaces, dashboard sharing)."
    },
    "fnd": {
      "label": "Founder",
      "name": "Founder (super admin)",
      "desc": "Sees the whole Plan including targets and founders-only themes, agrees, re-dates and splits milestones, decides proposals, and uses the Founders' catch-up and Re-plan screens. A Founder is also an Admin."
    },
    "ass": {
      "label": "Associate",
      "name": "Founders' Associate",
      "desc": "Reads every plan item that is not founders-only (never the targets) and the weekly review for any team. Read-only on the Plan."
    }
  },
