  "roles": {
    "view": {
      "label": "Viewer",
      "name": "Viewer",
      "desc": "Can open every screen and read it. Changes nothing."
    },
    "auth": {
      "label": "Author",
      "name": "Author",
      "desc": "Builds segments, templates and campaigns. Cannot send."
    },
    "mgr": {
      "label": "Manager",
      "name": "Manager",
      "desc": "Everything an Author can do, plus pressing send and activating journeys."
    },
    "appr": {
      "label": "Approver",
      "name": "Approver",
      "desc": "Signs off campaigns that are over the approval threshold."
    },
    "adm": {
      "label": "Admin",
      "name": "Admin",
      "desc": "Adds people, manages senders and connectors, edits consent."
    },
    "sadm": {
      "label": "Super-admin",
      "name": "Super-admin",
      "desc": "Owns roles, approval thresholds, caps and quiet hours."
    }
  },
