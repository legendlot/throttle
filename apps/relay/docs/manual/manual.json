{
  "title": "Relay",
  "title_accent": "Operations Manual",
  "subtitle": "The self-serve guide to every screen in Relay, the system that talks to customers.",
  "version": "1.7.0",
  "date": "2026-09-02",
  "app_url": "relay.legendoftoys.com",
  "owner": "Legend of Toys",
