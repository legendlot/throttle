{
  "title": "Podium",
  "title_accent": "Operations Manual",
  "subtitle": "The self-serve guide to Legend of Toys' people & performance system: profiles, the org chart, observations, wins, 1:1s, OKRs, appraisals and the people-data that stays private by design.",
  "version": "1.12.0",
  "date": "2026-11-14",
  "app_url": "podium.legendoftoys.com",
  "owner": "Legend of Toys",
  "roles": {
    "emp": {
      "label": "Employee",
      "name": "Employee (self-serve)",
      "desc": "Everyone with a login. Sees their own profile and records their own wins; takes part in their own appraisal. No view of anyone else by default."
    },
    "mgr": {
      "label": "Manager",
      "name": "People Manager",
      "desc": "Anyone with people reporting to them (directly or down the line). Sees the full profiles of their reporting chain, logs observations and 1:1s, and reviews their team's appraisals. Manager powers come from the org chart, not a role."
    },
    "hr": {
      "label": "HR",
      "name": "HR / People Team",
      "desc": "Manages people, departments, roles, documents and org snapshots, and runs appraisal cycles. Sees everyone's full profile, including bank, ID and PAN that managers cannot."
    },
    "adm": {
      "label": "Admin",
      "name": "Administrator",
      "desc": "Everything HR can do, plus Podium's own roles & permissions, the user assignments, and system settings (including the salary vault)."
    }
  },
